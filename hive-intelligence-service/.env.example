# HoneyChain Hive Intelligence & Blockchain Relayer Service
NODE_ENV=production
PORT=5002

# Ethereum Network RPC Endpoint (e.g. Sepolia public RPC or Alchemy/Infura)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployed HoneyChainCore Smart Contract Address
CONTRACT_ADDRESS=0xb3675732Ffb093562fA27E0385EFD5156478542A

# Relayer Master Authority Private Key (e.g. account 0x556FCE98dC5b75C5097eEf0581BC17f771944EbB)
# Note: In production, ensure this account holds a small balance of testnet ETH for gas fees
RELAYER_PRIVATE_KEY=your_private_key_without_or_with_0x

# Risk Analyzer & Anomaly Detection Parameters
RISK_THRESHOLD=70
TIME_GAP_WARNING=86400
