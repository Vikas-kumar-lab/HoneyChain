# ===================================================
# HoneyChain Environment Variables Template
# ===================================================

# 1. Blockchain RPC (Sepolia Public Testnet or Alchemy / Infura)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# 2. Relayer Wallet Private Key (MetaMask account private key with Sepolia ETH)
# DO NOT commit real private key to GitHub!
RELAYER_PRIVATE_KEY=0x_your_ethereum_sepolia_wallet_private_key_here

# 3. Smart Contract Address (Output from: npx truffle migrate --network sepolia)
CONTRACT_ADDRESS=0x_your_deployed_sepolia_contract_address_here

# 4. Backend Service Config (Render / Railway)
PORT=5002
USE_GANACHE=false

# 5. OpenRouter AI Engine (Madhu-Mitra & Telemetry AI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 6. Frontend Client Config (Set this in Vercel Environment Variables)

# REACT_APP_API_URL=https://your-backend-name.onrender.com
# REACT_APP_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# REACT_APP_CHAIN_ID=11155111

